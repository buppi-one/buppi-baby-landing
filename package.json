{
  "name": "buppi-baby-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prepare-blog",
    "dev": "next dev",
    "build": "npm run prepare-blog && next build && npm run fix-html-lang && npm run build-search",
    "fix-html-lang": "tsx scripts/fix-html-lang.ts",
    "build-search": "pagefind --site out",
    "start": "next start",
    "lint": "next lint",
    "prepare-blog": "npm run validate-blog && npm run copy-blog-assets",
    "validate-blog": "tsx src/lib/blog/validate.ts",
    "copy-blog-assets": "tsx src/lib/blog/copy-assets.ts",
    "new-post": "tsx src/lib/blog/new-post.ts",
    "translation-status": "tsx src/lib/blog/translation-status.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "15.3.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "pagefind": "^1.5.2",
    "satori": "^0.29.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
